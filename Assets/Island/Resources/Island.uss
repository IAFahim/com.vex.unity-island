.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    width: 100%;
    height: 100%;
}

.pill {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 412px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(18, 18, 23, 0.82);
    border-radius: 28px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
}

.left {
    flex-direction: column;
    align-items: center;
    width: auto;
    margin-bottom: 10px;
}

.dot {
    width: 8px;
    height: 8px;
    margin-right: 0;
    margin-bottom: 6px;
    background-color: rgb(89, 242, 140);
    border-radius: 4px;
}

.clock {
    flex-grow: 1;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgb(255, 255, 255);
    width: 68px;
    white-space: normal;
}

.meta {
    font-size: 11px;
    color: rgb(209, 214, 224);
    -unity-text-align: middle-center;
}

.brand {
    width: auto;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

.pill.files {
    background-color: rgba(36, 20, 30, 0.90);
    border-color: rgba(255, 176, 200, 0.28);
}

.dot.files {
    background-color: rgb(255, 168, 196);
}
