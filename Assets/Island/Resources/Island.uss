.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    width: 100%;
    height: 100%;
}

.pill {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 412px;
    height: 80px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(18, 18, 23, 0.82);
    border-radius: 28px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
}

.left {
    flex-direction: row;
    align-items: center;
    width: 90px;
}

.dot {
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background-color: rgb(89, 242, 140);
    border-radius: 4px;
}

.clock {
    flex-grow: 1;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(255, 255, 255);
}

.meta {
    font-size: 13px;
    color: rgb(209, 214, 224);
    -unity-text-align: middle-left;
}

.brand {
    width: 78px;
    -unity-text-align: middle-right;
}

.pill.files {
    background-color: rgba(36, 20, 30, 0.90);
    border-color: rgba(255, 176, 200, 0.28);
}

.dot.files {
    background-color: rgb(255, 168, 196);
}
